# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cinematch_user:cinematch_pass@localhost:5432/cinematch

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── TMDB (opcional) ───────────────────────────────────────────────────────────
# Obtén tu API key gratis en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Servicio ML (lo proporciona el compañero de ML) ──────────────────────────
ML_SERVICE_URL=http://localhost:8001
